{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: gcc.exe build active file",
			"command": "C:/msys64/mingw64/bin/gcc.exe",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${file}",
				"${fileDirname}/msgs.c",
				"-I${workspaceFolder}/include/buffers",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}.exe"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "compiler: C:/msys64/mingw64/bin/gcc.exe"
		},
		{
			"type": "cppbuild",
			"label": "C/C++: gcc.exe build active file",
			"command": "C:/msys64/mingw64/bin/gcc.exe",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${workspaceFolder}/msgs.c",  // Add this line,
				"${workspaceFolder}/external/buffers/buffers.c",  // Add this line,
				"-I",
				"${workspaceFolder}/external",
				"-o",
				"${fileDirname}/build/${fileBasenameNoExtension}.exe",
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"detail": "compiler: C:/msys64/mingw64/bin/gcc.exe"			
		},
		{
			"label": "Build tests.c",
			"type": "shell",
			"command": "gcc",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"./msgs.c",
				"./external/buffers/buffers.c",
				"./Tests/tests.c",
				"-I./external",
				"-I./include",
				"-o",
				"./build/tests.exe"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"],
			"detail": "Compiling tests.c using gcc"
		},

		
	]
}